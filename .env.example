# =============================================================================
# NovaWallet - Environment Configuration Template
# Copy this file to .env and configure values for production deployment
# =============================================================================

# Flask Secret Key for session signing (use a cryptographically secure random string)
FLASK_SECRET_KEY=change-this-in-production-to-a-secure-random-token

# JWT Secret Key for signing authentication tokens
JWT_SECRET_KEY=change-this-in-production-to-a-secure-jwt-secret

# Server Port and Host
PORT=5000
FLASK_DEBUG=0

# Database URI (defaults to SQLite in instance/novawallet.db if unset)
# For PostgreSQL: postgresql://user:password@localhost:5432/novawallet
# DATABASE_URL=sqlite:///instance/novawallet.db

# Optional: Google Gemini API Key for dynamic AI Financial Advisory
# Get a key from: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
